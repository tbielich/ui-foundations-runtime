{% macro toggleButton(label, dataName, dataValue, variant='outline') -%}
{%- set classes = "uif-button" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
<button class="{{ classes }}" type="button"{% if dataName == "mode" %} data-mode="{{ dataValue }}"{% endif %}{% if dataName == "brand" %} data-brand="{{ dataValue }}"{% endif %}{% if dataName == "lang" %} data-lang="{{ dataValue }}"{% endif %} aria-pressed="false">{{ label }}</button>
{%- endmacro %}

{% macro button(label, variant='', disabled=false, type='button') -%}
{%- set resolvedVariant = variant if variant == "outline" or variant == "ghost" else "solid" -%}
{%- set classes = "uif-button " + resolvedVariant -%}
<button type="{{ type }}" class="{{ classes }}"{% if disabled %} disabled{% endif %}>{{ label }}</button>
{%- endmacro %}

{% macro buttonGroup(attached=false, orientation='horizontal', justify='start', ariaLabel='', className='') -%}
{%- set resolvedOrientation = "vertical" if orientation == "vertical" else "horizontal" -%}
{%- set resolvedJustify = "stretch" if justify == "stretch" else "start" -%}
{%- set classes = "uif-button-group" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}" role="group" data-orientation="{{ resolvedOrientation }}" data-attached="{{ "true" if attached else "false" }}" data-justify="{{ resolvedJustify }}"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro input(type='text', placeholder='', value='', state='default', disabled=false, className='', id='', name='', dataPlaygroundControl=false, dataProp='', dataSource='', dataValueType='', dataQueryParam='') -%}
{%- set wrapperClasses = "uif-input-field" -%}
{%- if state == "hover" -%}{%- set wrapperClasses = wrapperClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set wrapperClasses = wrapperClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set wrapperClasses = wrapperClasses + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set wrapperClasses = wrapperClasses + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set wrapperClasses = wrapperClasses + " " + className -%}{%- endif -%}
<div class="{{ wrapperClasses }}">
  <input class="uif-input" type="{{ type }}"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if dataPlaygroundControl %} data-playground-control{% endif %}{% if dataProp %} data-prop="{{ dataProp }}"{% endif %}{% if dataSource %} data-source="{{ dataSource }}"{% endif %}{% if dataValueType %} data-value-type="{{ dataValueType }}"{% endif %}{% if dataQueryParam %} data-query-param="{{ dataQueryParam }}"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-input-field-control">
    {%- if type == "text" or type == "email" or type == "search" or type == "url" or type == "tel" -%}
    <button type="button" aria-label="Clear input" tabindex="-1"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross-circled.svg');" aria-hidden="true"></span></button>
    {%- elif type == "number" -%}
    <button type="button" aria-label="Decrease value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/minus-circled.svg');" aria-hidden="true"></span></button>
    <button type="button" aria-label="Increase value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/plus-circled.svg');" aria-hidden="true"></span></button>
    {%- elif type == "password" -%}
    <button type="button" aria-label="Toggle password visibility"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/view.svg');" aria-hidden="true"></span></button>
    {%- elif type == "date" -%}
    <button type="button" aria-label="Open date picker"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/calendar.svg');" aria-hidden="true"></span></button>
    {%- endif -%}
  </span>
</div>
{%- endmacro %}

{% macro checkbox(label='Checkbox', checked=false, disabled=false, state='default', indeterminate=false, className='', wrapperClassName='', id='', name='', value='on') -%}
{%- set checkboxClasses = "uif-checkbox" -%}
{%- set fieldClasses = "uif-checkbox-field" -%}
{%- if checked -%}{%- set checkboxClasses = checkboxClasses + " is-checked" -%}{%- endif -%}
{%- if indeterminate or state == "indeterminate" -%}{%- set checkboxClasses = checkboxClasses + " is-indeterminate" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set checkboxClasses = checkboxClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set checkboxClasses = checkboxClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set checkboxClasses = checkboxClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set checkboxClasses = checkboxClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set checkboxClasses = checkboxClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ checkboxClasses }}" type="checkbox"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if indeterminate or state == "indeterminate" %} data-indeterminate{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-checkbox-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro radio(label='Option', checked=false, disabled=false, state='default', className='', wrapperClassName='', id='', name='', value='') -%}
{%- set radioClasses = "uif-radio" -%}
{%- set fieldClasses = "uif-radio-field" -%}
{%- if checked -%}{%- set radioClasses = radioClasses + " is-checked" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set radioClasses = radioClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set radioClasses = radioClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set radioClasses = radioClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set radioClasses = radioClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set radioClasses = radioClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ radioClasses }}" type="radio"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-radio-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro switch(label='Notifications', checked=false, disabled=false, state='default', className='', wrapperClassName='', id='', name='', value='on') -%}
{%- set switchClasses = "uif-switch" -%}
{%- set fieldClasses = "uif-switch-field" -%}
{%- if checked -%}{%- set switchClasses = switchClasses + " is-checked" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set switchClasses = switchClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set switchClasses = switchClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set switchClasses = switchClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set switchClasses = switchClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set switchClasses = switchClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ switchClasses }}" type="checkbox" role="switch"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-switch-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro colorChip(token) -%}
<div class="swatch" style="--swatch-color: var({{ token.cssVar }})">
  <span class="swatch-name">{{ token.name }}</span>
  <span class="swatch-meta">{{ token.value }}</span>
</div>
{%- endmacro %}

{% macro icon(name, label='', className='') -%}
{%- set classes = "uif-icon" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" style="--uif-icon-src: url('/assets/icons/{{ name }}.svg');"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}></span>
{%- endmacro %}

{% macro labelContent(text='', startIcon='', endIcon='', iconOnly=false) -%}
<span class="uif-label-content{% if iconOnly %} is-icon-only{% endif %}">
  {%- if startIcon %}<span class="uif-icon" data-slot="start" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
  {%- if not iconOnly %}<span class="uif-label-content-text">{{ text }}</span>{% endif -%}
  {%- if endIcon %}<span class="uif-icon" data-slot="end" style="--uif-icon-src: url('/assets/icons/{{ endIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
</span>
{%- endmacro %}

{% macro fieldLabel(text, htmlFor='', required=false, startIcon='') -%}
<label class="uif-field-label"{% if htmlFor %} for="{{ htmlFor }}"{% endif %}>
  <span class="uif-label-content">
    {%- if startIcon %}<span class="uif-icon" data-slot="start" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
    <span class="uif-label-content-text">{{ text }}</span>
  </span>
  {%- if required %}
  <span class="uif-field-label-required" aria-hidden="true">*</span>
  <span class="uif-field-label-required-text"> (required)</span>
  {%- endif %}
</label>
{%- endmacro %}

{% macro link(text, href='#', startIcon='', endIcon='', state='', disabled=false) -%}
{%- set classes = "uif-link" -%}
{%- if state -%}{%- set classes = classes + " is-" + state -%}{%- endif -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
<a class="{{ classes }}" href="{{ href }}"{% if disabled %} aria-disabled="true"{% endif %}>
  {%- if startIcon %}<span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span> {% endif -%}
  {{ text }}
  {%- if endIcon %} <span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ endIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
</a>
{%- endmacro %}

{% macro badge(text, variant='', size='', startIcon='') -%}
{%- set classes = "uif-badge" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if size == "sm" -%}{%- set classes = classes + " sm" -%}{%- endif -%}
<span class="{{ classes }}">
  {%- if startIcon %}<span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
  <span class="uif-badge-text">{{ text }}</span>
</span>
{%- endmacro %}

{% macro divider(orientation='horizontal', variant='', className='') -%}
{%- set classes = "uif-divider" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<hr class="{{ classes }}"{% if orientation == "vertical" %} aria-orientation="vertical"{% endif %} />
{%- endmacro %}

{% macro textarea(placeholder='', value='', disabled=false, readonly=false, rows='', state='default', className='') -%}
{%- set classes = "uif-textarea" -%}
{%- if state == "hover" -%}{%- set classes = classes + " is-hover" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set classes = classes + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<textarea class="{{ classes }}"{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if rows %} rows="{{ rows }}"{% endif %}{% if readonly %} readonly{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %}>{{ value }}</textarea>
{%- endmacro %}

{% macro avatar(src='', alt='', initials='', size='', className='') -%}
{%- set classes = "uif-avatar" -%}
{%- if size and size != "md" -%}{%- set classes = classes + " " + size -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" role="img" aria-label="{{ alt or initials }}">
  {%- if src -%}<img src="{{ src }}" alt="{{ alt }}" />{%- else -%}<span class="uif-avatar-initials">{{ initials }}</span>{%- endif -%}
</span>
{%- endmacro %}

{% macro accordion(className='') -%}
{%- set classes = "uif-accordion" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro accordionItem(title='', open=false, disabled=false) -%}
{%- set classes = "uif-accordion-item" -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
<details class="{{ classes }}"{% if open %} open{% endif %}>
  <summary>{{ title }}</summary>
  <div class="uif-accordion-item-content">{{ caller() }}</div>
</details>
{%- endmacro %}

{% macro tabList(orientation='horizontal', ariaLabel='', className='') -%}
{%- set classes = "uif-tab-list" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}" role="tablist" aria-orientation="{{ orientation }}"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro tab(label='', selected=false, disabled=false, controls='', href='') -%}
{%- set classes = "uif-tab" -%}
{%- if selected -%}{%- set classes = classes + " is-active" -%}{%- endif -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if href -%}
<a class="{{ classes }}" href="{{ href }}"{% if disabled %} aria-disabled="true" tabindex="-1"{% endif %}>{{ label }}</a>
{%- else -%}
<button class="{{ classes }}" role="tab" type="button" aria-selected="{{ "true" if selected else "false" }}"{% if controls %} aria-controls="{{ controls }}"{% endif %}{% if disabled %} disabled{% endif %} tabindex="{{ "0" if selected else "-1" }}">{{ label }}</button>
{%- endif -%}
{%- endmacro %}

{% macro tabPanels(className='') -%}
{%- set classes = "uif-tab-panels" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro tabPanel(id='', hidden=false) -%}
<div class="uif-tab-panel" role="tabpanel"{% if id %} id="{{ id }}"{% endif %}{% if hidden %} hidden{% endif %} tabindex="0">{{ caller() }}</div>
{%- endmacro %}

{% macro tooltip(text='', placement='top', className='', showDelay=300, hideDelay=0, tooltipId='') -%}
{%- set classes = "uif-tooltip-trigger" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" style="--uif-tooltip-show-delay: {{ showDelay }}ms; --uif-tooltip-hide-delay: {{ hideDelay }}ms">{{ caller() }}<span class="uif-tooltip"{% if tooltipId %} id="{{ tooltipId }}"{% endif %} role="tooltip" data-placement="{{ placement }}">{{ text }}</span></span>
{%- endmacro %}

{% macro form(borderless=false, className='') -%}
{%- set classes = "uif-form" -%}
{%- if borderless -%}{%- set classes = classes + " borderless" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<form class="{{ classes }}" novalidate>{{ caller() }}</form>
{%- endmacro %}

{% macro formGroup(title='', className='') -%}
{%- set classes = "uif-form-group" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<fieldset class="{{ classes }}">
  {%- if title %}<legend class="uif-form-group-title">{{ title }}</legend>{% endif -%}
  {{ caller() }}
</fieldset>
{%- endmacro %}

{% macro formField(labelPosition='top', invalid=false, className='') -%}
{%- set classes = "uif-form-field" -%}
{%- if invalid -%}{%- set classes = classes + " is-invalid" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}"{% if labelPosition == "side" %} data-label-position="side"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro select(options=[], placeholder='', value='', state='default', disabled=false, invalid=false, className='', id='', name='') -%}
{%- set classes = "uif-select" -%}
{%- if state == "hover" -%}{%- set classes = classes + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set classes = classes + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set classes = classes + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if invalid -%}{%- set classes = classes + " is-invalid" -%}{%- endif -%}
{%- if not value and placeholder -%}{%- set classes = classes + " is-placeholder" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<select class="{{ classes }}"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %}>
  {%- if placeholder %}
  <option value="" disabled{% if not value %} selected{% endif %}>{{ placeholder }}</option>
  {%- endif -%}
  {%- for opt in options -%}
    {%- if opt.group %}
  <optgroup label="{{ opt.group }}">
      {%- for item in opt.items %}
    <option value="{{ item.value }}"{% if item.value == value %} selected{% endif %}>{{ item.label }}</option>
      {%- endfor %}
  </optgroup>
    {%- else %}
  <option value="{{ opt.value }}"{% if opt.value == value %} selected{% endif %}>{{ opt.label }}</option>
    {%- endif -%}
  {%- endfor %}
</select>
{%- endmacro %}

{% macro formHelper(text='') -%}
<p class="uif-form-field-helper">{{ text }}</p>
{%- endmacro %}

{% macro formActions(align='end', className='') -%}
{%- set classes = "uif-form-actions" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}"{% if align != "end" %} data-align="{{ align }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{# ─── Table ───────────────────────────────────────────────────────── #}

{% macro tableWrapper(className='') -%}
{%- set classes = "uif-table-wrapper" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro table(density='', selection='', sortable=false, resizable=false, className='') -%}
{%- set classes = "uif-table" -%}
{%- if density -%}{%- set classes = classes + " uif-table--" + density -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="uif-table-wrapper"><table class="{{ classes }}"{% if selection %} data-selection="{{ selection }}"{% endif %}>{{ caller() }}</table></div>
{%- endmacro %}

{% macro tableHead() -%}
<thead>{{ caller() }}</thead>
{%- endmacro %}

{% macro tableBody() -%}
<tbody>{{ caller() }}</tbody>
{%- endmacro %}

{% macro tableFoot() -%}
<tfoot>{{ caller() }}</tfoot>
{%- endmacro %}

{% macro th(label='', sort=false, resizable=false, className='') -%}
{%- if sort -%}<th{% if className %} class="{{ className }}"{% endif %} aria-sort="none">{{ label }}</th>
{%- elif resizable -%}<th{% if className %} class="{{ className }}"{% endif %} data-resizable>{{ label }}</th>
{%- else -%}<th{% if className %} class="{{ className }}"{% endif %}>{{ label }}</th>
{%- endif -%}
{%- endmacro %}

{% macro tr(cells=[], selected=false, className='') -%}
<tr{% if selected %} aria-selected="true"{% endif %}{% if className %} class="{{ className }}"{% endif %}>
  {%- for cell in cells -%}<td>{{ cell }}</td>{%- endfor -%}
</tr>
{%- endmacro %}

{% macro td(className='') -%}
<td{% if className %} class="{{ className }}"{% endif %}>{{ caller() }}</td>
{%- endmacro %}

{# ─── Re-export Calendar macro ────────────────────────────────────── #}

{%- from "macros/calendar.njk" import calendar as _cal -%}
{%- macro calendar(month='2026-07', selectedDate='', todayDate='', state='default', disabled=false, container=true, className='', id='', rangeStart='', rangeEnd='') -%}
{{- _cal(month, selectedDate, todayDate, state, disabled, container, className, id, rangeStart, rangeEnd) }}
{%- endmacro -%}


{% macro dialog(title='', description='', dismissible=true, open=false, confirmLabel='Confirm', cancelLabel='Cancel') -%}
<uif-dialog title="{{ title }}"{% if description %} description="{{ description }}"{% endif %} dismissible="{{ 'true' if dismissible else 'false' }}"{% if open %} open{% endif %} confirm-label="{{ confirmLabel }}" cancel-label="{{ cancelLabel }}">{{ caller() }}</uif-dialog>
{%- endmacro %}

{% macro statusLight(text, variant='neutral', size='md') -%}
{%- set classes = "uif-status-light" -%}
{%- if variant in ["positive", "negative", "notice", "info"] -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if size == "sm" -%}{%- set classes = classes + " sm" -%}{%- endif -%}
<span class="{{ classes }}">
  <span class="uif-status-light-indicator" aria-hidden="true"></span>
  <span class="uif-status-light-text">{{ text | escape }}</span>
</span>
{%- endmacro %}

{% macro meter(label='Storage used', value=72, min=0, max=100, variant='default', size='md', valueText='') -%}
{%- set min = min | float(0) -%}
{%- set max = max | float(100) -%}
{%- if max <= min -%}{%- set max = min + 1 -%}{%- endif -%}
{%- set value = value | float(0) -%}
{%- set value = min if value < min else (max if value > max else value) -%}
{%- set normalized = ((value - min) / (max - min)) * 100 -%}
{%- set label = (label | trim) or 'Meter' -%}
{%- set displayValue = (valueText | trim) or ((normalized | round) ~ '%') -%}
{%- set classes = 'uif-meter' -%}
{%- if variant in ['positive', 'notice', 'negative'] -%}{%- set classes = classes + ' ' + variant -%}{%- endif -%}
{%- if size == 'sm' -%}{%- set classes = classes + ' sm' -%}{%- endif -%}
<div class="{{ classes }}">
  <div class="uif-meter-header"><span class="uif-meter-label">{{ label | escape }}</span><span class="uif-meter-value">{{ displayValue | escape }}</span></div>
  <meter class="uif-meter-native" min="{{ min }}" max="{{ max }}" value="{{ value }}" aria-label="{{ label | escape }}" aria-valuetext="{{ displayValue | escape }}">{{ displayValue | escape }}</meter>
  <div class="uif-meter-track" aria-hidden="true"><span class="uif-meter-fill" style="inline-size: {{ normalized }}%;"></span></div>
</div>
{%- endmacro %}

{% macro progressBar(value='', variant='default', size='md', label='', showValue=false, indeterminate=false) -%}
{%- set number = value | float -%}
{%- set unknown = indeterminate or value === '' or value === none or number != number -%}
{%- set value = 0 if number < 0 else (100 if number > 100 else number) -%}
{%- set label = label | trim -%}
{%- set classes = 'uif-progress-bar' -%}
{%- if variant in ['info', 'positive', 'negative'] -%}{%- set classes = classes + ' ' + variant -%}{%- endif -%}
{%- if size in ['sm', 'lg'] -%}{%- set classes = classes + ' ' + size -%}{%- endif -%}
{%- if unknown -%}{%- set classes = classes + ' is-indeterminate' -%}{%- endif -%}
<div class="{{ classes }}" role="progressbar" aria-label="{{ (label or ('Loading' if unknown else 'Progress')) | escape }}" aria-valuemin="0" aria-valuemax="100"{% if not unknown %} aria-valuenow="{{ value }}"{% endif %}>
  {%- if label or (showValue and not unknown) %}<div class="uif-progress-bar-header">{% if label %}<span class="uif-progress-bar-label">{{ label | escape }}</span>{% endif %}{% if showValue and not unknown %}<span class="uif-progress-bar-value">{{ value | round }}%</span>{% endif %}</div>{% endif %}
  <progress class="uif-progress-bar-native" max="100"{% if not unknown %} value="{{ value }}"{% endif %} aria-hidden="true"></progress>
  <div class="uif-progress-bar-track"><div class="uif-progress-bar-fill"{% if not unknown %} style="--_progress: {{ value }}"{% endif %}></div></div>
</div>
{%- endmacro %}

{% macro inlineAlert(title='', description='', variant='', icon='', size='md', dismissible=false, actionLabel='', actionHref='') -%}
{%- if actionHref and not r/^(?:https?:|mailto:|tel:|\/|#)/.test(actionHref) -%}{%- set actionHref = '#' -%}{%- endif -%}
{%- set variantIcons = { 'info': 'info-circled', 'positive': 'checkmark-circled', 'negative': 'cross-circled', 'notice': 'exclamation-mark-circled' } -%}
{%- set classes = 'uif-inline-alert' -%}
{%- if variant in ['info', 'positive', 'negative', 'notice'] -%}{%- set classes = classes + ' ' + variant -%}{%- endif -%}
{%- if size == 'sm' -%}{%- set classes = classes + ' sm' -%}{%- endif -%}
{%- set iconName = (icon | trim) or variantIcons[variant] -%}
<div class="{{ classes }}" role="alert">
  {%- if iconName %}<span class="uif-inline-alert-icon"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ iconName }}.svg')" aria-hidden="true"></span></span>{% endif %}
  <div class="uif-inline-alert-content">
    {%- if title %}<strong class="uif-inline-alert-title">{{ title | escape }}</strong>{% endif %}
    {%- if description %}<p class="uif-inline-alert-description">{{ description | escape }}</p>{% endif %}
    {%- if actionLabel %}<div class="uif-inline-alert-action">{% if actionHref %}<a class="uif-button outline" href="{{ actionHref | escape }}">{{ actionLabel | escape }}</a>{% else %}<button type="button" class="uif-button outline">{{ actionLabel | escape }}</button>{% endif %}</div>{% endif %}
  </div>
  {%- if dismissible %}<button type="button" class="uif-inline-alert-dismiss" aria-label="Dismiss"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross.svg')" aria-hidden="true"></span></button>{% endif %}
</div>
{%- endmacro %}

{% macro toast(message='', variant='info', duration=5000, urgency='', actionLabel='', dismissLabel='Dismiss notification') -%}
{%- set variant = variant if variant in ['info', 'success', 'warning', 'error'] else 'info' -%}
{%- set urgency = urgency if urgency in ['polite', 'assertive'] else ('assertive' if variant == 'error' else 'polite') -%}
{%- set role = 'alert' if urgency == 'assertive' else 'status' -%}
{%- set icons = { 'info': 'info-circled', 'success': 'checkmark-circled', 'warning': 'exclamation-mark-circled', 'error': 'cross-circled' } -%}
<div class="uif-toast {{ variant }}" role="{{ role }}" aria-live="{{ urgency }}" aria-atomic="true" data-duration="{{ duration }}">
  <span class="uif-toast-icon"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ icons[variant] }}.svg')" aria-hidden="true"></span></span>
  <div class="uif-toast-content"><p class="uif-toast-message">{{ message | escape }}</p>{% if actionLabel %}<button type="button" class="uif-toast-action uif-button ghost">{{ actionLabel | escape }}</button>{% endif %}</div>
  <button type="button" class="uif-toast-dismiss" aria-label="{{ dismissLabel | escape }}"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross.svg')" aria-hidden="true"></span></button>
</div>
{%- endmacro %}

{% macro toastRegion(label='Notifications', position='top-end') -%}
{%- set position = position if position in ['top-start', 'top-end', 'bottom-start', 'bottom-end'] else 'top-end' -%}
<div class="uif-toast-region" role="region" aria-label="{{ label | escape }}" data-position="{{ position }}">{{ caller() }}</div>
{%- endmacro %}

{% macro popover(triggerId='popover-trigger', triggerLabel='Show details', label='Details', placement='bottom', open=false) -%}
{%- set placement = placement if placement in ['top', 'bottom', 'left', 'right'] else 'bottom' -%}
<button id="{{ triggerId | escape }}" class="uif-button outline uif-popover-trigger" type="button" aria-haspopup="dialog" aria-controls="{{ triggerId | escape }}-popover" aria-expanded="{{ 'true' if open else 'false' }}">{{ triggerLabel | escape }}</button>
<uif-popover trigger="{{ triggerId | escape }}" label="{{ label | escape }}" placement="{{ placement }}"{% if open %} open{% endif %}>{{ caller() }}</uif-popover>
{%- endmacro %}

{% macro breadcrumbs(items=[], label='Breadcrumb', separator='/', collapseAt=4) -%}
{%- set currentIndexes = [] -%}
{%- for item in items -%}
  {%- if item.current and currentIndexes.length == 0 -%}
    {%- set currentIndexes = (currentIndexes.push(loop.index0), currentIndexes) -%}
  {%- endif -%}
{%- endfor -%}
{%- set currentIndex = currentIndexes[0] if currentIndexes.length else items.length - 1 -%}
{%- set shouldCollapse = items.length > collapseAt -%}
<nav class="uif-breadcrumbs" aria-label="{{ label | escape }}" style="--uif-breadcrumbs-separator: '{{ separator | escape }}';">
  <ol class="uif-breadcrumbs-list">
  {%- for item in items %}
    {%- set isCurrent = loop.index0 == currentIndex -%}
    {%- set hiddenMiddle = shouldCollapse and loop.index0 > 0 and loop.index0 < items.length - 2 -%}
    {%- if not hiddenMiddle %}
    <li class="uif-breadcrumbs-item">{% if item.href and not isCurrent %}<a href="{{ item.href | escape }}">{{ item.label | escape }}</a>{% else %}<span{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label | escape }}</span>{% endif %}</li>
    {%- elif loop.index0 == 1 %}
    <li class="uif-breadcrumbs-item uif-breadcrumbs-disclosure-item"><details class="uif-breadcrumbs-disclosure"><summary class="uif-breadcrumbs-disclosure-trigger" aria-label="Show hidden breadcrumb items">…</summary><ol class="uif-breadcrumbs-hidden-list">
      {%- for hiddenItem in items.slice(1, items.length - 2) %}{% set hiddenIndex = loop.index0 + 1 %}{% set isCurrent = hiddenIndex == currentIndex %}<li class="uif-breadcrumbs-item">{% if hiddenItem.href and not isCurrent %}<a href="{{ hiddenItem.href | escape }}">{{ hiddenItem.label | escape }}</a>{% else %}<span{% if isCurrent %} aria-current="page"{% endif %}>{{ hiddenItem.label | escape }}</span>{% endif %}</li>{% endfor -%}
    </ol></details></li>
    {%- endif %}
  {%- endfor %}
  </ol>
</nav>
{%- endmacro %}

{% macro card(title='', layout='vertical', href='', selectable=false, selected=false, actionLabel='', id='') -%}
{%- set layout = 'horizontal' if layout == 'horizontal' else 'vertical' -%}
{%- set cardId = id | trim -%}
{%- set titleId = cardId + '-title' -%}
<article class="uif-card" data-layout="{{ layout }}"{% if cardId %} id="{{ cardId | escape }}"{% endif %}{% if title and cardId %} aria-labelledby="{{ titleId | escape }}"{% else %} aria-label="{{ (title or 'Card') | escape }}"{% endif %}{% if selectable %} data-selected="{{ 'true' if selected else 'false' }}"{% endif %}>
  {%- if title %}<header class="uif-card-header" data-slot="header"><h3 class="uif-card-title"{% if cardId %} id="{{ titleId | escape }}"{% endif %}>{{ title | escape }}</h3></header>{% endif %}
  <div class="uif-card-body" data-slot="body">{{ caller() }}</div>
  {%- if selectable or href %}<footer class="uif-card-footer" data-slot="footer">{% if selectable %}<button class="uif-card-control" type="button" aria-pressed="{{ 'true' if selected else 'false' }}">{{ (actionLabel or ('Deselect ' if selected else 'Select ') + (title or 'card')) | escape }}</button>{% else %}<a class="uif-card-control" href="{{ href | escape }}">{{ (actionLabel or 'Open ' + (title or 'card')) | escape }}</a>{% endif %}</footer>{% endif %}
</article>
{%- endmacro %}

{% macro tag(label='Tag', size='md', removable=false, icon='', avatarSrc='', removeLabel='') -%}
<span class="uif-tag{% if size == 'sm' %} sm{% endif %}" role="listitem">
  {%- if avatarSrc %}<img class="uif-tag-avatar" src="{{ avatarSrc | escape }}" alt="" aria-hidden="true">{% elif icon %}<span class="uif-icon uif-tag-icon" style="--uif-icon-src: url('/assets/icons/{{ icon | escape }}.svg')" aria-hidden="true"></span>{% endif %}
  <span class="uif-tag-label">{{ label | escape }}</span>
  {%- if removable %}<button class="uif-tag-remove" type="button" aria-label="{{ (removeLabel or 'Remove ' + label) | escape }}"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross.svg')" aria-hidden="true"></span></button>{% endif %}
</span>
{%- endmacro %}

{% macro tagGroup(label='Tags', overflow='wrap') -%}
<div class="uif-tag-group" role="list" aria-label="{{ label | escape }}" data-overflow="{{ 'scroll' if overflow == 'scroll' else 'wrap' }}">{{ caller() }}</div>
{%- endmacro %}

{% macro skeleton(shape='text', lines=1, width='', height='') -%}
{%- set shape = shape if shape in ['text', 'circle', 'rectangle'] else 'text' -%}
{%- set lines = lines if shape == 'text' and lines > 0 else 1 -%}
<span class="uif-skeleton-group" aria-hidden="true">
  {%- for index in range(0, lines) %}<span class="uif-skeleton {{ shape }}{% if lines > 1 and loop.last %} is-last-line{% endif %}"{% if width or height %} style="{% if width %}inline-size: {{ width | escape }};{% endif %}{% if height %} block-size: {{ height | escape }};{% endif %}"{% endif %}></span>{% endfor %}
</span>
{%- endmacro %}

{% macro illustratedMessage(preset='empty', heading='', description='', illustrationIcon='', actionLabel='', actionHref='', actionVariant='solid', size='md') -%}
{%- if actionHref and not r/^(?:https?:|mailto:|tel:|\/|#)/.test(actionHref) -%}{%- set actionHref = '#' -%}{%- endif -%}
{%- set presets = {
  'empty': { 'heading': 'Nothing here yet', 'description': 'Add content or create a new item to get started.', 'icon': 'message-info' },
  'error': { 'heading': 'Something went wrong', 'description': 'Try again or go back to the previous step.', 'icon': 'message-alert' },
  'no-results': { 'heading': 'No results found', 'description': 'Try adjusting your filters or search terms.', 'icon': 'search' }
} -%}
{%- set preset = preset if preset in ['empty', 'error', 'no-results'] else 'empty' -%}
{%- set defaults = presets[preset] -%}
{%- set heading = (heading | trim) or defaults.heading -%}
{%- set description = (description | trim) or defaults.description -%}
{%- set iconName = (illustrationIcon | trim) or defaults.icon -%}
{%- set actionVariant = actionVariant if actionVariant in ['solid', 'outline', 'ghost'] else 'solid' -%}
{%- set classes = 'uif-illustrated-message' -%}
{%- if size == 'sm' -%}{%- set classes = classes + ' sm' -%}{%- endif -%}
<div class="{{ classes }}" data-preset="{{ preset }}">
  <div class="uif-illustrated-message-illustration" aria-hidden="true"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ iconName }}.svg');" aria-hidden="true"></span></div>
  <div class="uif-illustrated-message-content">
    {%- if heading %}<h2 class="uif-illustrated-message-heading">{{ heading | escape }}</h2>{% endif %}
    {%- if description %}<p class="uif-illustrated-message-description">{{ description | escape }}</p>{% endif %}
  </div>
  {%- if actionLabel %}<div class="uif-illustrated-message-actions">{% if actionHref %}<a class="uif-button {{ actionVariant }}" href="{{ actionHref | escape }}">{{ actionLabel | escape }}</a>{% else %}<button class="uif-button {{ actionVariant }}" type="button">{{ actionLabel | escape }}</button>{% endif %}</div>{% endif %}
</div>
{%- endmacro %}

{% macro progressCircle(value='', label='Loading', size='md') -%}
{%- set number = value | float -%}
{%- set unknown = value === '' or value === none or number is not number or number != number -%}
{%- set value = 0 if number < 0 else (100 if number > 100 else number) -%}
{%- set resolvedSize = size if size == 'sm' or size == 'lg' else 'md' -%}
{%- set classes = 'uif-progress-circle' -%}
{%- if resolvedSize != 'md' -%}{%- set classes = classes + ' ' + resolvedSize -%}{%- endif -%}
{%- if unknown -%}{%- set classes = classes + ' is-indeterminate' -%}{%- endif -%}
<span class="{{ classes }}" role="progressbar" aria-label="{{ label | escape }}"{% if not unknown %} aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ value }}" style="--uif-progress-circle-value: {{ value }}"{% endif %}>
  <svg viewBox="0 0 36 36" aria-hidden="true">
    <circle class="uif-progress-circle-track" cx="18" cy="18" r="15.9155"></circle>
    <circle class="uif-progress-circle-indicator" cx="18" cy="18" r="15.9155" pathLength="100"></circle>
  </svg>
</span>
{%- endmacro %}
