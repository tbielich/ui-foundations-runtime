{
  "name": "ui-foundations",
  "version": "0.9.0",
  "description": "Token-first UI foundations with CSS, tokens, macros, and Web Components.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git@ssh.source.tui:Thomas.Bielich/ui-foundations.git"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "docs/foundations/**",
    "docs/migrations/react-to-web-components.md",
    "docs/migrations/public-api-namespace-v1.md",
    "docs/agentic/assistant-behavior-rules.md",
    "docs/agentic/team-ai-playbook.md",
    "docs/agentic/skills/**"
  ],
  "exports": {
    "./core.css": "./dist/core/index.css",
    "./ui.css": "./dist/ui/index.css",
    "./assets/*": "./dist/assets/*",
    "./tokens/core.css": "./dist/tokens/css/core-primitives.tokens.css",
    "./tokens/primitives.css": "./dist/tokens/css/core-primitives.tokens.css",
    "./tokens/brand-a.css": "./dist/tokens/css/semantics-brands.tokens.brand-a.css",
    "./tokens/brand-b.css": "./dist/tokens/css/semantics-brands.tokens.brand-b.css",
    "./tokens/brand-c.css": "./dist/tokens/css/semantics-brands.tokens.brand-c.css",
    "./tokens/brand-semantics-a.css": "./dist/tokens/css/semantics-brands.tokens.brand-a.css",
    "./tokens/brand-semantics-b.css": "./dist/tokens/css/semantics-brands.tokens.brand-b.css",
    "./tokens/brand-semantics-c.css": "./dist/tokens/css/semantics-brands.tokens.brand-c.css",
    "./tokens/color.css": "./dist/tokens/css/appearance-modes.tokens.mode-light.css",
    "./tokens/color-light.css": "./dist/tokens/css/appearance-modes.tokens.mode-light.css",
    "./tokens/color-dark.css": "./dist/tokens/css/appearance-modes.tokens.mode-dark.css",
    "./tokens/semantic.css": "./dist/tokens/css/semantics-brands.tokens.brand-a.css",
    "./tokens/components.css": "./dist/tokens/css/patterns-ui.tokens.css",
    "./tokens/core.json": "./dist/tokens/json/core-primitives.tokens.json",
    "./tokens/primitives.json": "./dist/tokens/json/core-primitives.tokens.json",
    "./tokens/brand-a.json": "./dist/tokens/json/semantics-brands.tokens.brand-a.json",
    "./tokens/brand-b.json": "./dist/tokens/json/semantics-brands.tokens.brand-b.json",
    "./tokens/brand-c.json": "./dist/tokens/json/semantics-brands.tokens.brand-c.json",
    "./tokens/brand-semantics-a.json": "./dist/tokens/json/semantics-brands.tokens.brand-a.json",
    "./tokens/brand-semantics-b.json": "./dist/tokens/json/semantics-brands.tokens.brand-b.json",
    "./tokens/brand-semantics-c.json": "./dist/tokens/json/semantics-brands.tokens.brand-c.json",
    "./tokens/color-light.json": "./dist/tokens/json/appearance-modes.tokens.mode-light.json",
    "./tokens/color-dark.json": "./dist/tokens/json/appearance-modes.tokens.mode-dark.json",
    "./tokens/semantic.json": "./dist/tokens/json/semantics-brands.tokens.brand-a.json",
    "./tokens/components.json": "./dist/tokens/json/patterns-ui.tokens.json",
    "./macros/ui.njk": "./dist/macros/ui.njk",
    "./elements": "./dist/elements/index.js",
    "./elements/ui-icon": "./dist/elements/ui-icon.js",
    "./elements/ui-button": "./dist/elements/ui-button.js",
    "./elements/ui-input": "./dist/elements/ui-input.js",
    "./elements/ui-checkbox": "./dist/elements/ui-checkbox.js",
    "./elements/ui-radio": "./dist/elements/ui-radio.js",
    "./elements/ui-switch": "./dist/elements/ui-switch.js",
    "./elements/ui-badge": "./dist/elements/ui-badge.js",
    "./elements/ui-divider": "./dist/elements/ui-divider.js",
    "./elements/ui-textarea": "./dist/elements/ui-textarea.js",
    "./elements/ui-avatar": "./dist/elements/ui-avatar.js",
    "./elements/ui-accordion": "./dist/elements/ui-accordion.js",
    "./elements/ui-tabs": "./dist/elements/ui-tabs.js",
    "./elements/ui-tooltip": "./dist/elements/ui-tooltip.js",
    "./elements/ui-select": "./dist/elements/ui-select.js",
    "./elements/ui-link": "./dist/elements/ui-link.js",
    "./elements/ui-label": "./dist/elements/ui-label.js",
    "./elements/ui-form": "./dist/elements/ui-form.js"
  },
  "scripts": {
    "icons:generate-list": "node scripts/generate-icon-list.mjs",
    "plugin:meta": "node scripts/generate-plugin-meta.mjs",
    "lint:js": "node scripts/lint-js.mjs",
    "lint": "npm run lint:js",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "npm run test:unit",
    "smoke:check": "node scripts/smoke-check.mjs",
    "assets:check": "node scripts/check-asset-refs.mjs",
    "rules:validate": "node scripts/validate-rule-pipeline.mjs",
    "uif:sync-check": "node scripts/uif-sync-check.mjs",
    "naming:generate": "node scripts/generate-vault-naming-contract.mjs",
    "naming:check": "node scripts/check-vault-naming-contract.mjs",
    "tokens:generate": "node scripts/extract-tokens.js",
    "tokens:sync": "node scripts/sync-figma-tokens.mjs",
    "tokens:dump": "node scripts/dump-figma-variables.mjs",
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "tokens:usage": "node scripts/validate-token-usage.mjs",
    "dtcg:validate": "node scripts/validate-dtcg.mjs",
    "tokens:build": "npm run tokens:generate",
    "build:css": "node scripts/build-css.mjs",
    "build:raw": "npm run icons:generate-list && npm run tokens:generate && npm run build:css",
    "build:all": "node scripts/build.mjs",
    "build:verbose": "npm run build:raw",
    "build": "npm run build:all",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run ci:check && npm run pack:check",
    "release:patch": "npm run release:check && npm version patch",
    "release:minor": "npm run release:check && npm version minor",
    "release:major": "npm run release:check && npm version major",
    "release:push": "git push origin main --follow-tags",
    "release:publish": "npm publish",
    "docs:build": "eleventy",
    "docs:site": "npm run build:all && npm run docs:build",
    "docs:dev": "node scripts/build.mjs dev",
    "docs:dev:verbose": "npm run build:raw && eleventy --serve",
    "docs:lint": "node scripts/check-docs-drift.mjs",
    "ci:check": "npm run lint && npm run test:unit && npm run docs:lint && npm run naming:check && npm run build:all && npm run smoke:check && npm run tokens:validate && npm run tokens:usage && npm run dtcg:validate && npm run assets:check && npm run rules:validate && npm run docs:build"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@figma/code-connect": "^1.2.0",
    "fast-check": "^4.8.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "prismjs": "^1.30.0"
  }
}
